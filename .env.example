# Application
APP_NAME=CareerPrep
ENVIRONMENT=development
DEBUG=false

# Logging. INFO = one line per request + warnings/errors; WARNING = quieter.
LOG_LEVEL=INFO
LOG_LIBS_LEVEL=WARNING
# Print every SQL statement? Very noisy.
LOG_SQL=false
LOG_ACCESS=true
LOG_MAX_MESSAGE_CHARS=600
SECRET_KEY=change-me-to-a-long-random-string

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8001

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=careerprep
POSTGRES_PASSWORD=satyam@975
POSTGRES_DB=careerprep

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---------- FREE LLMs (ordered fallback chain) ----------
# Requests walk LLM_CHAIN top to bottom. An entry is skipped automatically if its
# provider has no key, is cooling down after a 429, or is out of its own
# per-minute request/token budget. See backend/LLM_ROUTING.md.
#
# Keys (leave blank to skip that provider; no credit card needed for these):
#   Groq         https://console.groq.com/keys
#   OpenRouter   https://openrouter.ai/keys            (use ":free" models)
#   Gemini       https://aistudio.google.com/apikey
#   Hugging Face https://huggingface.co/settings/tokens (permission: "Make calls to Inference Providers")
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
HF_TOKEN=

# provider:model entries, comma-separated. Model names may contain ':' (e.g. ":free").
# Providers: groq, openrouter, gemini, huggingface (also cerebras, mistral, openai).
# Hugging Face is last on purpose: its free tier is only ~$0.10/month of credits.
LLM_CHAIN=groq:openai/gpt-oss-20b,openrouter:google/gemma-4-31b-it:free,openrouter:google/gemma-4-26b-a4b-it:free,gemini:gemini-3.5-flash-lite,huggingface:openai/gpt-oss-20b

# Requests-per-minute budget WE enforce (keep a little under the real limit).
# OpenRouter / Hugging Face limits are account-wide (shared by all their entries).
GROQ_RPM=25
OPENROUTER_RPM=15
GEMINI_RPM=5
HUGGINGFACE_RPM=10
# Groq free plan: 8K tokens/minute for gpt-oss-20b. Bigger requests skip Groq.
GROQ_TPM=7000

# gpt-oss reasoning effort on Groq / Hugging Face: low | medium | high (blank = default)
LLM_REASONING_EFFORT=low
GROQ_JSON_MODE=true

# If every entry is at its budget, wait up to this long, then answer "busy, retry in Ns"
LLM_MAX_WAIT_SECONDS=25
# Max real provider calls for one request (keeps fallback small)
LLM_MAX_ATTEMPTS=4
# Cache JD analysis / profile extraction / gap analysis for identical inputs
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=86400
# Embeds JD + resume with Gemini after every session. Nothing reads them yet.
RAG_INGEST_ENABLED=false

# Legacy (only the old single-provider helper and embeddings still use these)
LLM_PROVIDER=gemini
CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004

# ---------- OAuth (optional) ----------
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers → New OAuth App
# Authorization callback URL: http://localhost:8001/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Bootstrap admin (created on first startup)
ADMIN_EMAIL=admin@careerprep.local
ADMIN_PASSWORD=admin12345

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=careerprep

# ---------- JOB SEARCH SOURCES ----------
# Official public job-board APIs (no key needed). Comma-separated board names:
#   Greenhouse: boards.greenhouse.io/<token>   Lever: jobs.lever.co/<site>   Ashby: jobs.ashbyhq.com/<name>
# Boards that don't exist are skipped quietly. Add the companies you care about.
JOB_GREENHOUSE_BOARDS=stripe,airbnb,cloudflare,databricks,figma,coinbase,discord,reddit,robinhood,dropbox
JOB_LEVER_COMPANIES=palantir,spotify,plaid,cred
JOB_ASHBY_BOARDS=notion,ramp,linear,openai
# Direct company career pages that publish schema.org JobPosting JSON-LD (comma-separated URLs).
# These are shown FIRST in results.
JOB_CAREER_PAGE_URLS=

# LinkedIn / Indeed / Naukri-style listings come from aggregator APIs (those sites have no public
# search API and forbid scraping). Each key is optional; a source without a key is skipped.
#   JSearch (RapidAPI)  LinkedIn, Indeed, Glassdoor ...   https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
#   Adzuna              strong India coverage + salary    https://developer.adzuna.com/
#   Jooble              many portals                      https://jooble.org/api/about
JSEARCH_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
JOB_REMOTIVE_ENABLED=false
JOB_DEFAULT_COUNTRY=in
JOB_SOURCE_TIMEOUT_SECONDS=10
JOB_CACHE_TTL_SECONDS=600

